@ Sinnoh repo story scripts, trainers and triggers were removed; write TREY's story here by hand.

CanalaveCity_MapScripts::
	.byte 0

@ TREY (6b-4, D33): Canalave's transit stop (data/scripts/trey_transit.inc); the ship is the S.S. Tidal (D30).
CanalaveCity_TreyEventScript_FerrySailor::
	lock
	faceplayer
	setvar VAR_0x8004, TRANSIT_SHIP
	setvar VAR_0x8005, TRANSIT_STOP_CANALAVE
	setvar VAR_0x8007, 0
	call TreyTransit_EventScript_ChooseDestination
	goto_if_eq VAR_0x8006, TRANSIT_STOP_NONE, CanalaveCity_TreyEventScript_FerryEnd
	special TreyTransit_Board
	msgbox CanalaveCity_TreyText_AllAboard, MSGBOX_DEFAULT
	closemessage
	playse SE_EXIT
	fadescreen FADE_TO_BLACK
	warp MAP_SS_TIDAL_CORRIDOR, 1, 10
	waitstate
	release
	end

CanalaveCity_TreyEventScript_FerryEnd:
	release
	end

CanalaveCity_TreyText_AllAboard:
	.string "All aboard! Please head to your\n"
	.string "cabin and enjoy the voyage.$"
