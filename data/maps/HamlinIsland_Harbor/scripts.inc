HamlinIsland_Harbor_MapScripts::
	.byte 0

@ TREY (6c-4b, D43): Hamlin Harbor's transit stop (data/scripts/trey_transit.inc), the S.S. Tidal (D30).
HamlinIsland_Harbor_TreyEventScript_FerrySailor::
	lock
	faceplayer
	setvar VAR_0x8004, TRANSIT_SHIP
	setvar VAR_0x8005, TRANSIT_STOP_HAMLIN
	setvar VAR_0x8007, 0
	call TreyTransit_EventScript_ChooseDestination
	goto_if_eq VAR_0x8006, TRANSIT_STOP_NONE, HamlinIsland_Harbor_TreyEventScript_FerryEnd
	special TreyTransit_Board
	msgbox HamlinIsland_Harbor_TreyText_AllAboard, MSGBOX_DEFAULT
	closemessage
	playse SE_EXIT
	fadescreen FADE_TO_BLACK
	warp MAP_SS_TIDAL_CORRIDOR, 1, 10
	waitstate
	release
	end

HamlinIsland_Harbor_TreyEventScript_FerryEnd:
	release
	end

HamlinIsland_Harbor_TreyText_AllAboard:
	.string "All aboard! Please head to your\n"
	.string "cabin and enjoy the voyage.$"

HamlinIsland_Harbor_EventScript_Talk1::
	msgbox HamlinIsland_Harbor_Text_1, MSGBOX_NPC
	end

HamlinIsland_Harbor_Text_1:
	.string "I was hoping to take the ferry\n"
	.string "back to KANTO from here.\p"
	.string "Unfortunately, the ferry to KANTO\n"
	.string "is not running anymore.$"
