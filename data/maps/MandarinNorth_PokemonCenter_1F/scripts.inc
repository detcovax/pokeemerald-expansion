	faceplayer
	waitse
	playmoncry SPECIES_CHANSEY, CRY_MODE_NORMAL
	msgbox MandarinNorth_PokemonCenter_1F_Text_1, MSGBOX_DEFAULT
	waitmoncry
	release
	end

MandarinNorth_PokemonCenter_1F_EventScript_Talk2::
