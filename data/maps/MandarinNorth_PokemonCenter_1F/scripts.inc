	map_script MAP_SCRIPT_ON_TRANSITION, MandarinNorth_PokemonCenter_1F_TreyOnTransition
	.byte 0

MandarinNorth_PokemonCenter_1F_TreyOnTransition:
	setrespawn HEAL_LOCATION_MANDARIN_NORTH
	end

MandarinNorth_PokemonCenter_1F_TreyEventScript_Nurse::
