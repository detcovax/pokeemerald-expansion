@ (map 7.3). Story scripts, trainers and triggers were removed; write TREY's story here by hand.

MikanIsland_PokemonCenter_1F_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, MikanIsland_PokemonCenter_1F_TreyOnTransition
	.byte 0

MikanIsland_PokemonCenter_1F_TreyOnTransition:
	setrespawn HEAL_LOCATION_MIKAN_ISLAND
	end

MikanIsland_PokemonCenter_1F_TreyEventScript_Nurse::
	setvar VAR_0x800B, LOCALID_MIKAN_ISLAND_POKEMON_CENTER_1F_NURSE
	call Common_EventScript_PkmnCenterNurse
	waitmessage
	waitbuttonpress
	release
	end

MikanIsland_PokemonCenter_1F_EventScript_Talk1::
	lock
	faceplayer
	waitse
	playmoncry SPECIES_CHANSEY, CRY_MODE_NORMAL
	msgbox MikanIsland_PokemonCenter_1F_Text_1, MSGBOX_DEFAULT
	waitmoncry
	release
	end

MikanIsland_PokemonCenter_1F_EventScript_Talk2::
	msgbox MikanIsland_PokemonCenter_1F_Text_2, MSGBOX_NPC
	end

MikanIsland_PokemonCenter_1F_EventScript_Talk3::
