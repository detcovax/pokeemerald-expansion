	end

MikanIsland_PokemonCenter_1F_Text_1:
	.string "CHANSEY: Chaan! Sii!$"

MikanIsland_PokemonCenter_1F_Text_2:
	.string "I love the PHONE CALL function at\n"
	.string "every POKéMON CENTER’s PC.$"

MikanIsland_PokemonCenter_1F_Text_3:
	.string "According to some people, the\n"
	.string "ORANGE LEAGUE is harder than the\l"
	.string "INDIGO LEAGUE in KANTO.\p"
	.string "I have no idea whether that is\n"
	.string "true or not.$"

MikanIsland_PokemonCenter_1F_Text_4:
	.string "I lost a battle against CISSY in\n"
	.string "the MIKAN GYM.\p"
	.string "Now I’m looking for a good place\n"
	.string "to train my POKéMON.$"
