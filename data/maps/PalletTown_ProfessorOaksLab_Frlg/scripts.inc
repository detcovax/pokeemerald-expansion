@ TREY (5b, D27): the first time you talk to a professor, they give you their region's POKéDEX. Nothing else yet.
PalletTown_ProfessorOaksLab_TreyEventScript_ProfOak::
	lock
	faceplayer
	goto_if_set FLAG_TREY_DEX_KANTO, PalletTown_ProfessorOaksLab_TreyEventScript_ProfOakChat
	msgbox PalletTown_ProfessorOaksLab_TreyText_OakGivesDex, MSGBOX_DEFAULT
	setflag FLAG_SYS_POKEDEX_GET
	setflag FLAG_TREY_DEX_KANTO
	playfanfare MUS_RG_OBTAIN_KEY_ITEM
	message PalletTown_ProfessorOaksLab_TreyText_ReceivedDex
	waitmessage
	waitfanfare
	setqueststage QUEST_KANTO_STORY, 2
	msgbox PalletTown_ProfessorOaksLab_TreyText_OakAfterDex, MSGBOX_DEFAULT
	release
	end

PalletTown_ProfessorOaksLab_TreyEventScript_ProfOakChat::
