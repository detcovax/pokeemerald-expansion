@ TREY (5e): the ferry sailor at the S.S. Anne dock is Vermilion's transit stop (data/scripts/trey_transit.inc).
@ For now the ship is the S.S. Tidal (D30).
VermilionCity_TreyEventScript_FerrySailor::
	lock
	faceplayer
	setvar VAR_0x8004, TRANSIT_SHIP
	setvar VAR_0x8005, TRANSIT_STOP_VERMILION
	setvar VAR_0x8007, 0
	call TreyTransit_EventScript_ChooseDestination
	goto_if_eq VAR_0x8006, TRANSIT_STOP_NONE, VermilionCity_TreyEventScript_FerryEnd
	special TreyTransit_Board
	msgbox VermilionCity_TreyText_AllAboard, MSGBOX_DEFAULT
	closemessage
	playse SE_EXIT
	fadescreen FADE_TO_BLACK
	warp MAP_SS_TIDAL_CORRIDOR, 1, 10
	waitstate
	release
	end

VermilionCity_TreyEventScript_FerryEnd:
	release
	end

VermilionCity_TreyText_AllAboard:
	.string "All aboard! Please head to your\n"
	.string "cabin and enjoy the voyage.$"

